{
  "name": "saarmontage-website",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/prepare-next.mjs && next build --webpack && node scripts/export-next.mjs",
    "dev": "node scripts/prepare-next.mjs && next dev --webpack --hostname 127.0.0.1",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
